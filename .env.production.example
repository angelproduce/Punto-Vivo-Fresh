# =============================================================================
# PUNTO VIVO FRESH · plantilla de PRODUCCIÓN (Vercel/Render + Supabase)
# =============================================================================
# Este archivo es solo una REFERENCIA SEGURA: no contiene valores reales.
# No se sube: en Vercel/Render los valores se ponen en su Dashboard.
# Nunca publiques estos secretos en GitHub, JavaScript, QR ni documentación.
# -----------------------------------------------------------------------------

# Supabase → Project Settings > API > Project URL
PV_SUPABASE_URL=
# Supabase → Project Settings > API > service_role (SECRETO, solo servidor).
# NO usar la clave anon: la app escribe visitas, admins y sesiones.
PV_SUPABASE_SERVICE_ROLE_KEY=
# Bucket público creado por supabase_schema.sql
PV_SUPABASE_BUCKET=menu-images

# Vercel limita el cuerpo de petición a 4.5 MB: dejar 4194304 (4 MB).
PV_MAX_IMAGE_BYTES=4194304

# Render termina TLS (HTTPS); hay que confiar en X-Forwarded-* para cookies
# Secure y para la validación del origen (anti-CSRF).
PV_TRUST_PROXY=1

# URL HTTPS pública definitiva, SIN barra final y SIN /bienvenida.
# Ejemplo: https://punto-vivo-fresh.onrender.com
# Rellénase después del primer despliegue; el QR la codifica.
PV_PUBLIC_BASE_URL=

# Firma de cookies de visitante. Generar con:
# python -c "import secrets; print(secrets.token_hex(32))"
PV_SECRET_KEY=

# Primer administrador (opcional). Si se deja vacío, créalo desde Render Shell:
# python -m punto_vivo.admin create --email tu@correo.com
PV_ADMIN_EMAIL=
PV_ADMIN_PASSWORD=

# Puerto: Render lo asigna (habitualmente 10000). NO fijar 8790 en producción.
# PV_DB_PATH tampoco se define: en producción se usa Supabase, no SQLite.
