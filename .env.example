# Copia este archivo a .env y rellena solo lo que tengas.
# Nada de aqui es obligatorio: sin claves el proyecto funciona igual.

# --- Imagenes y fondos de video (gratis al registrarte) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Unsplash: Access Key de https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# --- Guiones con IA (opcional). Sin clave se usan las plantillas de topics.yaml ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ChatGPT / OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# GitHub Models (gratis con token de GitHub): https://github.com/settings/tokens
GITHUB_TOKEN=
# GITHUB_MODELS_TOKEN=  # alias de GITHUB_TOKEN

# --- Publicacion (opcional). Se configura en Ajustes o aqui. ---
FACEBOOK_PAGE_TOKEN=
# --- Voz (opcional, de pago) ---
# ElevenLabs: API key y ID de voz (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# --- Publicacion unificada (Zernio) ---
ZERNIO_API_KEY=
# --- Openverse (imágenes gratuitas, sin clave opcional) ---
OPENVERSE_API_KEY=

# ==========================================================
# PUNTO VIVO FRESH · menú digital y control de visitas
# ==========================================================
# Base pública FIJA que se codificará en el QR (ejemplo: https://menu.tudominio.com).
# Si se deja vacío, se usa la dirección desde la que se genera el QR.
PV_PUBLIC_BASE_URL=
# Dirección de escucha y puerto del servidor
PV_HOST=0.0.0.0
PV_PORT=8790
# Primer administrador (ejecuta también: .venv\Scripts\python.exe -m punto_vivo.admin create --email ...)
# NUNCA publiques estas credenciales.
PV_ADMIN_EMAIL=
PV_ADMIN_PASSWORD=
# Secreto opcional para firmar cookies. Si se omite se genera y guarda en state\punto_vivo_secret.key
PV_SECRET_KEY=
# Ruta de la base SQLite persistente (por defecto: state\punto_vivo.sqlite3)
PV_DB_PATH=
# Límites anti-abuso del formulario
PV_LIMITE_IP_HORA=20
PV_LIMITE_TELEFONO_HORA=6
# Tamaño máximo de foto subida (8 MB en local; usar 4194304 = 4 MB en Vercel)
PV_MAX_IMAGE_BYTES=
# Tamaño máximo del comprobante de transferencia (5242880 = 5 MB)
PV_MAX_PROOF_BYTES=
# Notificaciones del navegador al admin (Web Push/VAPID). Opcionales:
# en local se usa state/vapid.json como respaldo. La clave privada NUNCA va al navegador.
PV_VAPID_PUBLIC_KEY=
PV_VAPID_PRIVATE_KEY=
PV_VAPID_SUBJECT=

# ==========================================================
# PRODUCCIÓN (Render + Supabase) · solo para el servidor
# Copia estos nombres en Render > Dashboard > Environment.
# Ver punto_vivo/DEPLOY_RENDER.md y .env.production.example
# NUNCA pongas estos valores en JavaScript, GitHub ni el QR.
# ==========================================================
PV_SUPABASE_URL=
PV_SUPABASE_SERVICE_ROLE_KEY=
PV_SUPABASE_BUCKET=menu-images
PV_TRUST_PROXY=1
